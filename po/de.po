#: src/facetfall/game.py:173 src/facetfall/powerups.py:43
msgid "Extra life"
msgstr "Extraleben"

#: src/facetfall/game.py:559
#, python-brace-format
msgid "+{n} points"
msgstr "+{n} Punkte"

#: src/facetfall/game.py:603 src/facetfall/game.py:702
msgid "HI-SCORE"
msgstr "REKORD"

#: src/facetfall/game.py:615
msgid "Break every facet. Don't let the ball fall!"
msgstr "Zerschlage jede Facette. Lass den Ball nicht fallen!"

#: src/facetfall/game.py:617
msgid "On"
msgstr "An"

#: src/facetfall/game.py:617
msgid "Off"
msgstr "Aus"

#: src/facetfall/game.py:619
msgid "New game"
msgstr "Neues Spiel"

#: src/facetfall/game.py:620
#, python-brace-format
msgid "Continue from level {n}"
msgstr "Weiter ab Level {n}"

#: src/facetfall/game.py:621 src/facetfall/game.py:646
msgid "Bonuses"
msgstr "Boni"

#: src/facetfall/game.py:622
#, python-brace-format
msgid "Language: {name}"
msgstr "Sprache: {name}"

#: src/facetfall/game.py:623
#, python-brace-format
msgid "Sound: {state}"
msgstr "Ton: {state}"

#: src/facetfall/game.py:624
#, python-brace-format
msgid "Fullscreen: {state}"
msgstr "Vollbild: {state}"

#: src/facetfall/game.py:625
msgid "Quit"
msgstr "Beenden"

