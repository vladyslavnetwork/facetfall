msgid "P — continue    ESC — main menu"
msgstr "P — weiter    ESC — Hauptmenü"

#: src/facetfall/game.py:769
msgid "GAME OVER"
msgstr "SPIEL VORBEI"

#: src/facetfall/game.py:771
msgid "NEW HIGH SCORE!"
msgstr "NEUER REKORD!"

#: src/facetfall/game.py:773 src/facetfall/game.py:779
msgid "Press ENTER to continue"
msgstr "ENTER drücken, um fortzufahren"

#: src/facetfall/game.py:776
msgid "YOU WIN!"
msgstr "GEWONNEN!"

#: src/facetfall/game.py:777
#, python-brace-format
