#: src/facetfall/about.py:58 src/facetfall/game.py:637
msgid "About"
msgstr "O grze"

#: src/facetfall/about.py:59
#, python-brace-format
msgid "Version {v}"
msgstr "Wersja {v}"

#: src/facetfall/about.py:60
#, python-brace-format
msgid "Author: {name}"
msgstr "Autor: {name}"

#: src/facetfall/about.py:61
msgid "License: MIT"
msgstr "Licencja: MIT"

