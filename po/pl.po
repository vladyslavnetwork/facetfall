msgid "Extra life"
msgstr "Dodatkowe życie"

#: src/facetfall/game.py:559
#, python-brace-format
msgid "+{n} points"
msgstr "+{n} pkt"

#: src/facetfall/game.py:603 src/facetfall/game.py:702
msgid "HI-SCORE"
msgstr "REKORD"

#: src/facetfall/game.py:615
msgid "Break every facet. Don't let the ball fall!"
msgstr "Rozbij każdą fasetę. Nie upuść piłki!"

#: src/facetfall/game.py:617
msgid "On"
msgstr "Wł."

#: src/facetfall/game.py:617
msgid "Off"
msgstr "Wył."

#: src/facetfall/game.py:619
msgid "New game"
msgstr "Nowa gra"

#: src/facetfall/game.py:620
#, python-brace-format
msgid "Continue from level {n}"
msgstr "Kontynuuj od poziomu {n}"

#: src/facetfall/game.py:621 src/facetfall/game.py:646
msgid "Bonuses"
msgstr "Bonusy"

#: src/facetfall/game.py:622
#, python-brace-format
msgid "Language: {name}"
msgstr "Język: {name}"

#: src/facetfall/game.py:623
#, python-brace-format
msgid "Sound: {state}"
msgstr "Dźwięk: {state}"

#: src/facetfall/game.py:624
#, python-brace-format
msgid "Fullscreen: {state}"
msgstr "Pełny ekran: {state}"

#: src/facetfall/game.py:625
msgid "Quit"
msgstr "Wyjdź"

#: src/facetfall/game.py:640
#, python-brace-format
msgid "{n} levels · checkpoint every {k} levels"
msgstr "{n} poziomów · punkt kontrolny co {k} poziomów"

#: src/facetfall/game.py:642
msgid ""
"MOUSE or ARROWS move    CLICK or SPACE launch/fire    P pause    F11 "
"fullscreen"
msgstr ""
"MYSZ lub STRZAŁKI ruch    KLIK lub SPACJA start/strzał    P pauza    F11 "
"pełny ekran"

#: src/facetfall/game.py:657
msgid "Avoid:"
msgstr "Unikaj:"

#: src/facetfall/game.py:662
msgid "The further you get, the stronger the bonuses."
msgstr "Im dalej zajdziesz, tym mocniejsze bonusy."

#: src/facetfall/game.py:663
msgid "Press any key to return"
msgstr "Naciśnij dowolny klawisz, aby wrócić"

#: src/facetfall/game.py:700
msgid "SCORE"
msgstr "WYNIK"

#: src/facetfall/game.py:704 src/facetfall/game.py:757
#, python-brace-format
msgid "LEVEL {n}"
msgstr "POZIOM {n}"

#: src/facetfall/game.py:758
msgid "Click or press SPACE to launch"
msgstr "Kliknij lub naciśnij SPACJĘ, aby wystrzelić"

